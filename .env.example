# Host development URLs below; Compose uses db:5432 and rabbitmq:5672 internally.
# Keep credentials URL-safe because they are interpolated into connection URLs.
# Local PostgreSQL
POSTGRES_DB=studyhub
POSTGRES_USER=studyhub
POSTGRES_PASSWORD=studyhub_dev
STUDYHUB_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5433/${POSTGRES_DB}

# Local RabbitMQ
RABBITMQ_DEFAULT_USER=studyhub
RABBITMQ_DEFAULT_PASS=rabbitmq_dev
STUDYHUB_AMQP_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@127.0.0.1:5672/%2F

# Synthesis Service Database
SYNTHESIS_DB=synthesis_db
SYNTHESIS_DB_USER=synthesis
SYNTHESIS_DB_PASSWORD=synthesis_dev

# Ollama AI Configuration (Synthesis)
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_MODEL=llama3.2:1b
AI_CONTEXT_SIZE=4096
AI_OUTPUT_TOKENS=384
AI_TEMPERATURE=0.2
AI_SEED=42
AI_TIMEOUT_SECONDS=120
AI_MAX_CALLS=64
AI_MAX_SOURCE_BYTES=2000000
AI_MAX_JOB_SECONDS=900

# Explicit synthetic fixtures for development only; production must use search.
# Search currently has no agreed full-document contract and fails closed.
DOCUMENT_PROVIDER=mock
# Optional JSON fixture map keyed by Content document UUID, with version and content.
MOCK_DOCUMENTS_FILE=
SEARCH_SERVICE_URL=
RETRIEVAL_VERSION=search-contract-pending-v1

# Enable Alice and Bob for local testing
STUDYHUB_DEV_IDENTITY=1

# Generate a different value for each token in your local .env
STUDYHUB_PROCESSING_TOKEN=
STUDYHUB_SEARCH_TOKEN=
STUDYHUB_SYNTHESIS_TOKEN=
