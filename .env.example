# Host development URLs below; Compose uses db:5432 and rabbitmq:5672 internally.
# Keep credentials URL-safe because they are interpolated into connection URLs.
# Local PostgreSQL
POSTGRES_DB=studyhub
POSTGRES_USER=studyhub
POSTGRES_PASSWORD=studyhub_dev
STUDYHUB_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5433/${POSTGRES_DB}

# Local RabbitMQ
RABBITMQ_DEFAULT_USER=studyhub
RABBITMQ_DEFAULT_PASS=rabbitmq_dev
# Change host ports if a local RabbitMQ already uses the defaults.
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
STUDYHUB_AMQP_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@127.0.0.1:${RABBITMQ_HOST_PORT}/%2F

# Synthesis Service Database
SYNTHESIS_DB=synthesis_db
SYNTHESIS_DB_USER=synthesis
SYNTHESIS_DB_PASSWORD=synthesis_dev

# Ollama AI Configuration (Synthesis)
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_MODEL=llama3.2:1b
AI_CONTEXT_SIZE=4096
AI_OUTPUT_TOKENS=384
AI_TEMPERATURE=0.2
AI_SEED=42
AI_TIMEOUT_SECONDS=120
AI_MAX_CALLS=64
AI_MAX_SOURCE_BYTES=2000000
AI_MAX_JOB_SECONDS=900

# Explicit synthetic fixtures for development only; production must use search.
# Search currently has no agreed full-document contract and fails closed.
DOCUMENT_PROVIDER=mock
# Optional JSON fixture map keyed by Content document UUID, with version and content.
MOCK_DOCUMENTS_FILE=/app/dev-fixtures/documents.json
SEARCH_SERVICE_URL=
RETRIEVAL_VERSION=search-contract-pending-v1

# Enable Alice and Bob for local testing
STUDYHUB_DEV_IDENTITY=1

# Generate a different value for each token in your local .env
STUDYHUB_PROCESSING_TOKEN=
STUDYHUB_SEARCH_TOKEN=
STUDYHUB_SYNTHESIS_TOKEN=

# AI Processing: host Ollama endpoints. Full endpoint URLs.
# Host worker uses the URLs below; Compose supplies container-specific URLs.
# AI_MODEL and OLLAMA_BASE_URL above belong to Synthesis, not AI Processing.
AI_CONTENT_URL=http://127.0.0.1:8000
AI_SUMMARY_URL=http://127.0.0.1:11434/api/chat
AI_SUMMARY_MODEL=qwen3:4b
AI_SUMMARY_KEY=
AI_EMBEDDING_URL=http://127.0.0.1:11434/api/embed
AI_EMBEDDING_MODEL=bge-m3
AI_EMBEDDING_KEY=
# Start the host faster-whisper transcription server for audio processing.
AI_TRANSCRIPTION_URL=http://127.0.0.1:8001/v1/audio/transcriptions
AI_TRANSCRIPTION_MODEL=small
AI_TRANSCRIPTION_KEY=
AI_HTTP_TIMEOUT=300
AI_CHUNK_SIZE=2000
AI_CHUNK_OVERLAP=200
AI_MAX_ATTEMPTS=3

# ollama uses native APIs; openai selects the compatible third-party API format.
AI_MODEL_PROVIDER=ollama
AI_OLLAMA_CONTEXT=4096
AI_SUMMARY_MAX_TOKENS=512
# Host transcription server (macOS / Windows / Linux)
AI_TRANSCRIPTION_BIND=127.0.0.1
AI_TRANSCRIPTION_PORT=8001
AI_TRANSCRIPTION_DEVICE=cpu
AI_TRANSCRIPTION_COMPUTE_TYPE=int8
AI_TRANSCRIPTION_CPU_THREADS=4
# Leave empty for automatic language detection; use en or zh to force a language.
AI_TRANSCRIPTION_LANGUAGE=

# Model endpoints used by the Docker worker (Compose profile: processing).
# Override these separately when switching to a remote model provider.
AI_DOCKER_SUMMARY_URL=http://host.docker.internal:11434/api/chat
AI_DOCKER_EMBEDDING_URL=http://host.docker.internal:11434/api/embed
AI_DOCKER_TRANSCRIPTION_URL=http://host.docker.internal:8001/v1/audio/transcriptions
